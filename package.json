{
  "name": "mccl-valuation",
  "version": "2.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @mccl/api",
    "dev:web": "npm run dev -w @mccl/web",
    "db:dev": "npm run db:dev -w @mccl/api",
    "build": "npm run build -w @mccl/web && npm run build -w @mccl/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
