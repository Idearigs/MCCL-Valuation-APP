# ── Copy to apps/api/.env for local development ──────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# `npm run db:dev` starts a local Postgres with exactly this URL (no Docker needed)
DATABASE_URL=postgres://mccl:mccl@localhost:54320/mccl
PG_SSL=false

# Public origin (production only), e.g. https://valuation.mccullochjewellers.co.uk
# APP_ORIGIN=

# Built web app to serve (production image sets this to /app/web)
# WEB_DIST_DIR=

# ── Login: PIN only ──
SESSION_TTL_HOURS=12
PIN_LENGTH=4
# 32+ random chars. Changing it invalidates every PIN.  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PIN_PEPPER=
# First user, created on startup if missing (never overwritten). Add more with scripts/set-credentials.ts
ADMIN_NAME=Owner
ADMIN_EMAIL=owner@mccullochjewellers.co.uk
ADMIN_PIN=

# ── File storage: local (dev) or r2 (production) ──
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=../../.data/files
FILE_URL_SECRET=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=mcclvaluation-files
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# ── PDF rendering: chrome (local dev) or gotenberg (production) ──
PDF_RENDERER=chrome
# CHROME_PATH=
# GOTENBERG_URL=http://gotenberg:3000
STATIONERY_TOP_MM=65
STATIONERY_BOTTOM_MM=35

# SENTRY_DSN=
